;; Two physics rule packs on one seeded ball.
;; heavy: strong gravity, sticky bounce, hard ground friction (mid 1).
;; light: weak gravity, bouncy restitution, light friction (mid 2).
;; The longer-lived pack is stamped into the main slot. The other is dropped.
;; fiber_live only when both fiber joins return a numeric score.
;; Otherwise the same thunks run host-sequential. Never a fake fiber_live.

(define *score-heavy* 0)
(define *score-light* 0)
(define *keep-mid* 0)
(define *drop-mid* 0)
(define *keep-reason* "boot")
(define *drop-reason* "boot")
(define *main-name* "none")
(define *main-mid* 0)
(define *main-score* 0)
(define *world-line* "host-sequential")
(define *race-backend* 0)
(define *race-spawned* 0)
(define *race-joined* 0)

;; mid 1. g=4, bounce 1/3, friction 2.
(define (rules-heavy)
  (ar:score 4 1 3 2))

;; mid 2. g=1, bounce 2/3, friction 1.
(define (rules-light)
  (ar:score 1 2 3 1))

(define (ar:alive-of s)
  (quotient s 1000000))

(define (ar:energy-of s)
  (modulo s 1000000))

(define (ar:race-thunks! thunk-a thunk-b)
  (set! *race-spawned* (+ *race-spawned* 2))
  (let ((b (try (fiber:spawn-backend) (catch (e) 0))))
    (if (and (number? b) (> b 0))
        (set! *race-backend* b))
    (let* ((f1 (try (fiber:spawn thunk-a) (catch (e) #f)))
           (f2 (try (fiber:spawn thunk-b) (catch (e) #f)))
           (r1 (if (and (number? f1) (> f1 0))
                   (try (fiber:join f1) (catch (e) #f))
                   #f))
           (r2 (if (and (number? f2) (> f2 0))
                   (try (fiber:join f2) (catch (e) #f))
                   #f)))
      (if (and (number? f1) (number? f2)
               (> f1 0) (> f2 0)
               (not (= f1 f2))
               (number? r1) (number? r2))
          (begin
            (set! *race-joined* (+ *race-joined* 2))
            (list r1 r2))
          (list (thunk-a) (thunk-b))))))

(define (ar:finish-world!)
  (if (and (> *race-spawned* 0)
           (= *race-joined* *race-spawned*)
           (> *race-backend* 0))
      (set! *world-line* "fiber_live")
      (set! *world-line* "host-sequential"))
  *world-line*)

(define (ar:stamp-world!)
  (ar:finish-world!)
  (display "WORLD line=")
  (display *world-line*)
  (display " backend=")
  (display (number->string *race-backend*))
  (display " joins=")
  (display (number->string *race-joined*))
  (display "/")
  (display (number->string *race-spawned*))
  (newline)
  *world-line*)

;; Strictly longer survival wins. Equal survival breaks on integrated
;; kinetic energy. A full tie keeps heavy (mid 1).
(define (ar:decide! heavy light)
  (set! *score-heavy* heavy)
  (set! *score-light* light)
  (cond
    ((> light heavy)
     (set! *keep-mid* 2)
     (set! *drop-mid* 1)
     (set! *main-mid* 2)
     (set! *main-name* "rules-light")
     (if (> (ar:alive-of light) (ar:alive-of heavy))
         (begin
           (set! *keep-reason* "longer-survival-stamp")
           (set! *drop-reason* "shorter-survival-rollback"))
         (begin
           (set! *keep-reason* "higher-energy-stamp")
           (set! *drop-reason* "lower-energy-rollback")))
     (set! *main-score* (ar:stamp! 1 2 3 1 "rules-light")))
    ((> heavy light)
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "rules-heavy")
     (if (> (ar:alive-of heavy) (ar:alive-of light))
         (begin
           (set! *keep-reason* "longer-survival-stamp")
           (set! *drop-reason* "shorter-survival-rollback"))
         (begin
           (set! *keep-reason* "higher-energy-stamp")
           (set! *drop-reason* "lower-energy-rollback")))
     (set! *main-score* (ar:stamp! 4 1 3 2 "rules-heavy")))
    (#t
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "rules-heavy")
     (set! *keep-reason* "tie-keep-heavy-stamp")
     (set! *drop-reason* "tie-drop-light-rollback")
     (set! *main-score* (ar:stamp! 4 1 3 2 "rules-heavy"))))
  *main-mid*)

(define (ar:race!)
  (set! *race-backend* 0)
  (set! *race-spawned* 0)
  (set! *race-joined* 0)
  (set! *world-line* "host-sequential")
  (let ((pair (ar:race-thunks!
               (lambda () (rules-heavy))
               (lambda () (rules-light)))))
    (ar:decide! (car pair) (car (cdr pair))))
  (ar:finish-world!)
  *main-mid*)

(define (ar:audit!)
  (display "RACE heavy=")
  (display (ar:nstr *score-heavy*))
  (display " light=")
  (display (ar:nstr *score-light*))
  (display " alive-heavy=")
  (display (number->string (ar:alive-of *score-heavy*)))
  (display " alive-light=")
  (display (number->string (ar:alive-of *score-light*)))
  (newline)
  (ar:stamp-world!)
  (display "MAIN slot=")
  (display *main-name*)
  (display " mid=")
  (display (number->string *main-mid*))
  (display " score=")
  (display (ar:nstr *main-score*))
  (display " g=")
  (display (number->string *g*))
  (display " bounce=")
  (display (number->string *bn*))
  (display "/")
  (display (number->string *bd*))
  (display " fric=")
  (display (number->string *fric*))
  (display " alive=")
  (display (number->string *alive*))
  (display " energy=")
  (display (number->string *energy*))
  (newline)
  (display "KEEP mid=")
  (display (number->string *keep-mid*))
  (display " reason=")
  (display *keep-reason*)
  (newline)
  (display "DROP mid=")
  (display (number->string *drop-mid*))
  (display " reason=")
  (display *drop-reason*)
  (newline)
  0)
