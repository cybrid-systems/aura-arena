;; aura-arena M0 — one Soft FlatAST world, two physics rule packs.
;; A ball in a box. No C viewport. Rule packs differ by gravity, bounce, friction.
;; Positions and velocities are integers. Division truncates toward zero.

(define *horizon* 48)
(define *seed* 20261005)
(define *W* 64)
(define *H* 48)
(define *x* 0)
(define *y* 0)
(define *vx* 0)
(define *vy* 0)
(define *tick* 0)
(define *alive* 0)
(define *energy* 0)
(define *g* 0)
(define *bn* 0)
(define *bd* 1)
(define *fric* 0)
(define *slot-tag* "none")

(define (ar:dialect)
  "live-rules-arena-m0")

(define (ar:nstr n)
  (if (< n 0)
      (string-append "-" (number->string (- 0 n)))
      (number->string n)))

;; Toward-zero integer division. Does not use floor.
(define (ar:qdiv n d)
  (if (< n 0)
      (- 0 (quotient (- 0 n) d))
      (quotient n d)))

(define (ar:seed-step seed)
  (modulo (+ (* seed 75) 74) 65537))

(define (ar:fric-x vx fric)
  (cond
    ((> vx 0)
     (let ((n (- vx fric)))
       (if (< n 0) 0 n)))
    ((< vx 0)
     (let ((n (+ vx fric)))
       (if (> n 0) 0 n)))
    (#t 0)))

;; One tick. Returns (x y vx vy ke dead).
;; dead is 1 when the ball is on the floor with zero kinetic energy.
(define (ar:step x y vx vy g bn bd fric)
  (let* ((vy1 (- vy g))
         (x1 (+ x vx))
         (y1 (+ y vy1)))
    (let* ((hit-l (< x1 0))
           (hit-r (> x1 *W*))
           (xb (cond (hit-l 0) (hit-r *W*) (#t x1)))
           (vx1 (cond
                  (hit-l (- 0 (ar:qdiv (* vx bn) bd)))
                  (hit-r (- 0 (ar:qdiv (* vx bn) bd)))
                  (#t vx)))
           (hit-c (> y1 *H*))
           (yb0 (if hit-c *H* y1))
           (vy2 (if hit-c (- 0 (ar:qdiv (* vy1 bn) bd)) vy1))
           (hit-f (< yb0 0))
           (yb (if hit-f 0 yb0))
           (vy3 (if hit-f (- 0 (ar:qdiv (* vy2 bn) bd)) vy2))
           (vx2 (if hit-f (ar:fric-x vx1 fric) vx1))
           (ke (+ (* vx2 vx2) (* vy3 vy3)))
           (dead (if (and (= yb 0) (= ke 0)) 1 0)))
      (list xb yb vx2 vy3 ke dead))))

(define (ar:sx st) (car st))
(define (ar:sy st) (car (cdr st)))
(define (ar:svx st) (car (cdr (cdr st))))
(define (ar:svy st) (car (cdr (cdr (cdr st)))))
(define (ar:ske st) (car (cdr (cdr (cdr (cdr st))))))
(define (ar:sdead st) (car (cdr (cdr (cdr (cdr (cdr st)))))))

(define (ar:tape! tick st tag)
  (display "TAPE tick=")
  (display (number->string tick))
  (display " x=")
  (display (number->string (ar:sx st)))
  (display " y=")
  (display (number->string (ar:sy st)))
  (display " vx=")
  (display (ar:nstr (ar:svx st)))
  (display " vy=")
  (display (ar:nstr (ar:svy st)))
  (display " alive=")
  (display (number->string tick))
  (display " slot=")
  (display tag)
  (newline)
  0)

;; Pure play. tape=1 prints TAPE on the host replay only.
;; Returns (score alive energy x y vx vy) of the last in-play state.
;; A stuck ball (dead=1) is not committed: that frame is the rollback.
(define (ar:sim g bn bd fric tag tape)
  (let ((rng (ar:seed-step *seed*)))
    (let loop ((i 0)
               (x 16)
               (y 36)
               (vx (+ 2 (modulo rng 3)))
               (vy (modulo rng 5))
               (alive 0)
               (energy 0))
      (if (>= i *horizon*)
          (list (+ (* alive 1000000) energy) alive energy x y vx vy)
          (let ((st (ar:step x y vx vy g bn bd fric)))
            (if (= (ar:sdead st) 1)
                (list (+ (* alive 1000000) energy) alive energy x y vx vy)
                (begin
                  (if (and (= tape 1) (= (modulo (+ i 1) 10) 0))
                      (ar:tape! (+ i 1) st tag))
                  (loop (+ i 1)
                        (ar:sx st)
                        (ar:sy st)
                        (ar:svx st)
                        (ar:svy st)
                        (+ alive 1)
                        (+ energy (ar:ske st))))))))))

;; Score only. No set! of world slots, so a fiber race cannot clobber main.
(define (ar:score g bn bd fric)
  (car (ar:sim g bn bd fric "race" 0)))

(define (ar:stamp! g bn bd fric tag)
  (let ((st (ar:sim g bn bd fric tag 1)))
    (set! *g* g)
    (set! *bn* bn)
    (set! *bd* bd)
    (set! *fric* fric)
    (set! *slot-tag* tag)
    (set! *alive* (car (cdr st)))
    (set! *energy* (car (cdr (cdr st))))
    (set! *x* (car (cdr (cdr (cdr st)))))
    (set! *y* (car (cdr (cdr (cdr (cdr st))))))
    (set! *vx* (car (cdr (cdr (cdr (cdr (cdr st)))))))
    (set! *vy* (car (cdr (cdr (cdr (cdr (cdr (cdr st))))))))
    (set! *tick* *alive*)
    (car st)))
