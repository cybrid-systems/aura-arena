;; Multi-round propose → gate → play. Horizon defaults to 24 (smaller than M0).
;; Each round reads ARENA_ROUND_DIR/<n>.lambda. KEEP only on a strict improvement.
(load "/workspace/aura-arena/soft/arena/world.aura")
(load "/workspace/aura-arena/soft/arena/rules.aura")
(load "/workspace/aura-arena/soft/arena/propose.aura")

(define (ar:env-int name fallback)
  (let ((raw (getenv name)))
    (if (and (string? raw) (> (string-length raw) 0))
        (let ((n (string->number raw)))
          (if (number? n) n fallback))
        fallback)))

(define (ar:burn!)
  (let ((dir (getenv "ARENA_ROUND_DIR"))
        (rounds (ar:env-int "ARENA_BURN_ROUNDS" 3))
        (hz (ar:env-int "ARENA_HORIZON" 24)))
    (set! *horizon* hz)
    (display "BURN rounds=")
    (display (number->string rounds))
    (display " horizon=")
    (display (number->string hz))
    (newline)
    (if (not (and (string? dir) (> (string-length dir) 0)))
        (display "ARENA_BURN_FAIL dir\n")
        (let ((seeded (ar:strategy-seed!)))
          (if (not (and (pair? seeded) (equal? (car seeded) #t)))
              (display "ARENA_BURN_FAIL seed\n")
              (begin
                (let loop ((i 1))
                  (if (> i rounds)
                      0
                      (begin
                        (display "BURN_ROUND=")
                        (display (number->string i))
                        (newline)
                        (ar:propose-file!
                         (string-append dir "/" (number->string i) ".lambda"))
                        (loop (+ i 1)))))
                (ar:stamp-world!)
                (display "MAIN score=")
                (display (ar:nstr *main-score*))
                (newline)
                (display "ARENA_BURN_OK\n")))))))

(ar:burn!)
